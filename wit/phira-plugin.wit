// Phira-mp+ Plugin ABI v3 — WIT / Component Model
//
// This WIT file defines the plugin world `phira-plugin-v3`, the only supported
// plugin ABI. All host interfaces and guest exports are fully implemented.
//
// Status:
//   - Room state query, handler registration and TCP accept/recv are production-wired.
//   - Capability names unified to 'phira:' namespace.
//   - Release readiness still depends on workspace tests and real component fixtures.

package phira:plugin@0.3.0;

/// Core data types shared between host and guest.
interface phira-types {
    /// Touch event point from gameplay.
    record touch-event-point {
        time: f32,
        finger: u32,
        x: f32,
        y: f32,
    }

    /// Judge event item from gameplay.
    record judge-event-item {
        time: f32,
        line-id: u32,
        note-id: u32,
        judgement: string,
    }

    /// Plugin metadata returned by get-info.
    record plugin-info {
        name: string,
        version: string,
        author: string,
        description: string,
    }

    /// Result of an HTTP request made by the plugin.
    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    /// Player record data for GameEnd event.
    record game-end-record {
        user-id: u32,
        user-name: string,
        score: u32,
        accuracy: f32,
        perfect: u32,
        good: u32,
        bad: u32,
        miss: u32,
        max-combo: u32,
        full-combo: bool,
    }

    /// A generic JSON value. Used for plugin API arguments/results
    /// until the WIT interface is fully specialized.
    ///
    /// Array and object payloads are JSON-encoded as strings because
    /// the WIT parser does not support recursive type definitions.
    variant json-value {
        null,
        flag(bool),
        integer(s64),
        float(f64),
        text(string),
        array(string),
        object(string),
    }

    /// Host API result: either a JSON value or an error string.
    variant api-result {
        ok(json-value),
        error(string),
    }
}

/// Host functions available to WASM plugins.
interface phira-host {
    use phira-types.{touch-event-point, judge-event-item, plugin-info, http-response, json-value, api-result, game-end-record};

    /// Log a message from the plugin.
    log: func(level: string, message: string);

    /// Generate a UUID v4 string.
    generate-uuid: func() -> string;

    /// Get current timestamp in milliseconds.
    current-time-ms: func() -> u64;

    /// Call a server API method. Matches the host's ServerStateQuery interface.
    api-call: func(method: string, args: list<json-value>) -> api-result;

    /// Send a chat message as system (user-id 0) or as a specific user.
    send-chat: func(user-id: u32, message: string);

    /// Make an outbound HTTP request (sandboxed by WasmRuntimeConfig).
    http-request: func(url: string, method: string, headers: list<tuple<string, string>>, body: list<u8>) -> result<http-response, string>;
}

/// Events the host sends to plugins.
interface phira-events {
    use phira-types.{touch-event-point, judge-event-item, game-end-record};

    /// Payload for user-connect events.
    record user-connect-info {
        user-id: u32,
        user-name: string,
        user-ip: string,
    }

    /// Payload for user-disconnect events.
    record user-disconnect-info {
        user-id: u32,
        user-name: string,
    }

    /// Payload for room events that carry a user-id and room-id.
    record room-user-event {
        user-id: u32,
        room-id: string,
    }

    /// Payload for room-modify events.
    record room-modify-info {
        user-id: u32,
        room-id: string,
        data: string,
    }

    /// Payload for game-end events.
    record game-end-info {
        user-id: u32,
        room-id: string,
        game-result: game-end-record,
    }

    /// Payload for player-touches events.
    record player-touches-info {
        user-id: u32,
        room-id: string,
        data: list<touch-event-point>,
    }

    /// Payload for player-judges events.
    record player-judges-info {
        user-id: u32,
        room-id: string,
        data: list<judge-event-item>,
    }

    /// Payload for round-complete events.
    record round-complete-info {
        room-id: string,
        chart-id: u32,
        chart-name: string,
    }

    /// Payload for room-join events.
    record room-join-info {
        user-id: u32,
        room-id: string,
        is-monitor: bool,
    }

    /// All event types the host can dispatch to plugins.
    variant plugin-event {
        user-connect(user-connect-info),
        user-disconnect(user-disconnect-info),
        room-create(room-user-event),
        room-join(room-join-info),
        room-leave(room-user-event),
        room-modify(room-modify-info),
        game-start(room-user-event),
        game-end(game-end-info),
        player-touches(player-touches-info),
        player-judges(player-judges-info),
        round-complete(round-complete-info),
    }
}

/// User and room data query APIs available to plugins.
interface phira-query {
    use phira-types.{json-value, api-result};

    /// Get user basic info (id, name, language, monitor status).
    get-user: func(user-id: u32) -> api-result;

    /// Get user's extra extension data by key.
    get-user-extra: func(user-id: u32, key: string) -> api-result;

    /// Set user's extra extension data.
    set-user-extra: func(user-id: u32, key: string, value: string) -> api-result;

    /// Get room basic info (id, host, players, state, endpoint).
    get-room: func(room-id: string) -> api-result;

    /// Get room's extra extension data by key.
    get-room-extra: func(room-id: string, key: string) -> api-result;

    /// List all active room IDs.
    list-rooms: func() -> api-result;

    /// List online user IDs.
    list-online-users: func() -> api-result;

    /// Check if a user is currently online.
    is-user-online: func(user-id: u32) -> bool;
}

/// Room management operations.
interface phira-room-mgmt {
    use phira-types.{api-result};

    /// Create an empty persistent room with optional endpoint override.
    create-empty-room: func(room-id: string, endpoint: option<string>) -> api-result;

    /// Kick a user from a room.
    kick-from-room: func(room-id: string, target-id: u32) -> api-result;

    /// Transfer host to another user in the room.
    transfer-host: func(room-id: string, target-id: u32) -> api-result;

    /// Set room host (none = system ? host).
    set-host: func(room-id: string, target-id: option<u32>) -> api-result;

    /// Lock or unlock a room.
    set-room-lock: func(room-id: string, locked: bool) -> api-result;

    /// Hide or unhide a room (hidden rooms excluded from Web API).
    set-room-hidden: func(room-id: string, hidden: bool) -> api-result;

    /// 赛事模式房间（房间级配置）。开启后禁用 PMP 默认交互行为
    ///（准备倒计时自动开赛、每轮结算广播、房主自动转移、cycle 自动轮换、
    /// late-join、聊天），交 PPB 编排。
    set-room-tournament: func(room-id: string, tournament: bool) -> api-result;

    /// 设置房间 live 状态（建房自动置 true，此处可手动开关，供 Panel/PPB 控制）。
    set-room-live: func(room-id: string, live: bool) -> api-result;

    /// Close / disband a room.
    close-room: func(room-id: string) -> api-result;

    /// Set room-level phira_api_endpoint override.
    set-room-phira-api-endpoint: func(room-id: string, endpoint: option<string>) -> api-result;
}

/// User management and moderation.
interface phira-user-mgmt {
    use phira-types.{api-result};

    /// Kick a user from the server.
    kick-user: func(user-id: u32, reason: string) -> api-result;

    /// Ban a user.
    ban-user: func(user-id: u32, reason: string) -> api-result;

    /// Unban a user.
    unban-user: func(user-id: u32) -> api-result;

    /// List banned users.
    get-ban-list: func() -> api-result;

    /// Check if a user is banned.
    is-banned: func(user-id: u32) -> bool;
}

/// Messaging — send messages and broadcast.
interface phira-messaging {
    use phira-types.{api-result};

    /// Send a direct message to a specific user.
    send-to-user: func(user-id: u32, message: string) -> api-result;

    /// Broadcast a message to all users in a room.
    send-to-room: func(room-id: string, message: string) -> api-result;

    /// Broadcast a message to all connected users.
    send-to-all: func(message: string) -> api-result;
}

/// Persistence read API — incremental event/snapshot queries.
interface phira-persistence {
    use phira-types.{api-result};

    /// Query sequential events since a sequence number.
    query-events: func(since-sequence: u64, limit: u32, kind: option<string>, room-id: option<string>, user-id: option<u32>) -> api-result;

    /// Query room snapshots since a sequence number.
    query-room-snapshots: func(since-sequence: u64, limit: u32) -> api-result;

    /// Query touch batches.
    query-touches: func(since-sequence: u64, limit: u32, round-uuid: option<string>, player-id: option<u32>) -> api-result;

    /// Query judge batches.
    query-judges: func(since-sequence: u64, limit: u32, round-uuid: option<string>, player-id: option<u32>) -> api-result;

    /// Get playtime for a user.
    get-playtime: func(user-id: u32) -> api-result;

    /// Get top playtime ranking.
    top-playtime: func(limit: u32) -> api-result;
}

/// Admin Phira ID configuration.
interface phira-admin {
    use phira-types.{api-result};

    /// List admin Phira IDs.
    list-admin-ids: func() -> api-result;

    /// Check if a user is an admin.
    is-admin: func(user-id: u32) -> bool;

    /// Add an admin Phira ID.
    add-admin-id: func(user-id: u32) -> api-result;

    /// Remove an admin Phira ID.
    remove-admin-id: func(user-id: u32) -> api-result;

    /// Set the full admin ID list.
    set-admin-ids: func(ids: list<u32>) -> api-result;
}

/// Plugin configuration (key-value, JSON, per-plugin config.json on disk).
interface phira-config {
    use phira-types.{api-result};

    /// Get a configuration value by key path (e.g. "api.timeout").
    /// Returns null if the key does not exist.
    get-config: func(key-path: string) -> api-result;

    /// Set a configuration value by key path.
    /// Persisted to data/plugins/<name>/config.json.
    set-config: func(key-path: string, value: string) -> api-result;

    /// List all keys at the given prefix.
    list-config: func(prefix: string) -> api-result;

    /// Reload config.json from disk.
    reload-config: func() -> api-result;

    /// Poll for config changes since a version counter.
    poll-config-changes: func(since-version: u64) -> api-result;
}

/// Non-realtime timer for plugin-internal scheduling.
/// Cryptographic operations (host-side key management).
interface phira-crypto {
    /// Sign data with the server's node key.
    /// The private key never leaves the host process.
    sign: func(payload: list<u8>) -> result<list<u8>, string>;

    /// Verify a signature against a public key.
    verify: func(pubkey: list<u8>, payload: list<u8>, signature: list<u8>) -> result<bool, string>;

    /// SHA-256 hash of arbitrary data.
    sha256: func(data: list<u8>) -> result<list<u8>, string>;

    /// Get the server's node public key (for peer verification).
    get-node-public-key: func() -> result<list<u8>, string>;
}


interface phira-timer {
    /// Set a one-shot timer. When fired, host calls on-api("timer:fired", [timer-id]).
    set-timer: func(delay-ms: u64, timer-id: string) -> result<_, string>;

    /// Cancel a pending timer. No-op if timer already fired or unknown.
    clear-timer: func(timer-id: string) -> result<_, string>;
}


/// TCP networking — connect/listen/send/close with accept and event-driven receive.
interface phira-tcp {
    /// Connect to a remote TCP endpoint. Returns a connection handle.
    connect: func(addr: string) -> result<u64, string>;

    /// Start a TCP listener. Returns a listener handle.
    listen: func(addr: string) -> result<u64, string>;

    /// Send raw bytes on an established connection.
    send: func(handle: u64, bytes: list<u8>) -> result<_, string>;

    /// Accept an inbound connection from a listener (non-blocking).
    /// Returns null if no pending connection.
    /// Host also dispatches `on-api("tcp:accept", [listener, conn])` on arrival.
    accept: func(handle: u64) -> result<option<u64>, string>;

    /// Receive buffered data from a connection (non-blocking).
    /// Returns null if no data available.
    /// Host also dispatches `on-api("tcp:data", [conn, data])` on arrival.
    recv: func(handle: u64, max-bytes: u32) -> result<option<list<u8>>, string>;

    /// Close a connection or stop a listener by handle.
    close: func(handle: u64) -> result<_, string>;

    /// Get the remote address of a connection.
    peer-addr: func(handle: u64) -> result<string, string>;
}

/// Structured room state query — returns typed records instead of JSON blobs.
interface phira-room-state {
    /// A player's current status in a room.
    record room-player {
        user-id: u32,
        display-name: string,
        is-monitor: bool,
        is-ready: bool,
        is-host: bool,
        is-finished: bool,
        score: option<u32>,
        accuracy: option<f32>,
    }

    /// Current round metadata.
    record round-info {
        round-id: string,
        chart-id: option<u32>,
        chart-name: option<string>,
        phase: string,
    }

    /// Full structured room state.
    record room-state {
        room-id: string,
        room-uuid: string,
        host-id: option<u32>,
        locked: bool,
        hidden: bool,
        player-count: u32,
        monitor-count: u32,
        players: list<room-player>,
        current-round: option<round-info>,
    }

    /// Get structured room state by room ID.
    get-room-state: func(room-id: string) -> result<room-state, string>;

    /// Get all players in a room.
    get-room-players: func(room-id: string) -> result<list<room-player>, string>;

    /// Check a player's membership and status in a specific room.
    get-player-status: func(room-id: string, user-id: u32) -> result<option<room-player>, string>;

    /// List all active room IDs.
    list-rooms: func() -> result<list<string>, string>;
}

/// Dynamic handler registration — plugins can expose custom service methods.
interface phira-handler {
    /// Descriptor for a registered handler.
    record handler-descriptor {
        method: string,
        description: string,
        request-schema: option<string>,
        response-schema: option<string>,
    }

    /// Register a handler for a custom API method.
    /// When called, host dispatches `on-api(method, args)` to this plugin.
    /// Overrides any previous handler for the same method name.
    register-handler: func(desc: handler-descriptor) -> result<_, string>;

    /// Unregister a previously registered handler.
    unregister-handler: func(method: string) -> result<_, string>;

    /// List all handlers currently registered by this plugin.
    list-handlers: func() -> result<list<handler-descriptor>, string>;

    /// Update runtime capability set (admin only, checked by host policy).
    /// Adding capabilities requires host authorization.
    request-capability: func(capability: string) -> result<bool, string>;
}

/// Runtime diagnostics.
interface phira-runtime {
    use phira-types.{api-result};

    /// Get runtime v2 status summary (event bus, worker, registry).
    status: func() -> api-result;

    /// Get EventBus stats.
    events: func(limit: option<u32>) -> api-result;

    /// Get registered command stats.
    commands: func() -> api-result;
}

/// The plugin world — what a WASM plugin component must export
/// and what the host provides.
world phira-plugin-v3 {
    use phira-types.{plugin-info, json-value, api-result};
    use phira-events.{plugin-event};

    import phira-host;
    import phira-events;
    import phira-query;
    import phira-room-mgmt;
    import phira-user-mgmt;
    import phira-messaging;
    import phira-persistence;
    import phira-admin;
    import phira-config;
    import phira-crypto;
    import phira-tcp;
    import phira-timer;
    import phira-runtime;
    import phira-room-state;
    import phira-handler;

    export init: func() -> result<_, string>;
    export get-info: func() -> plugin-info;
    export cleanup: func();

    /// Called when the host dispatches an event to this plugin.
    /// Returns ok(true) if the plugin handled the event.
    export on-event: func(event: plugin-event) -> result<bool, string>;

    /// Called when something invokes a plugin-exposed API method.
    /// Returns the JSON result or error.
    export on-api: func(method: string, args: list<json-value>) -> api-result;
}
